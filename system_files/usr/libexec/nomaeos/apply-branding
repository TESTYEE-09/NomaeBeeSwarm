#!/usr/bin/env bash
set -euo pipefail

marker="${XDG_STATE_HOME:-$HOME/.local/state}/nomaeos/branding-v1"
wallpaper=/usr/share/wallpapers/NomaeOS/contents/images/3840x2160.svg

[[ -e "$marker" ]] && exit 0
[[ -r "$wallpaper" ]] || exit 0

mkdir -p "$(dirname "$marker")"

if command -v plasma-apply-wallpaperimage >/dev/null 2>&1; then
  if plasma-apply-wallpaperimage "$wallpaper"; then
    touch "$marker"
  fi
elif command -v qdbus6 >/dev/null 2>&1; then
  exit 0
fi
